{% extends '@PrestaShop/Admin/layout.html.twig' %}

{% block content %}

{# ------------------------------------------------------------------ #}
{# Flash messages                                                       #}
{# ------------------------------------------------------------------ #}
{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="alert alert-{% if label == 'success' %}success{% elseif label == 'error' %}danger{% else %}info{% endif %} alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    {% endfor %}
{% endfor %}

{# ------------------------------------------------------------------ #}
{# Section 1: Settings form                                             #}
{# ------------------------------------------------------------------ #}
<div class="card mb-4">
    <div class="card-header">
        <h3 class="card-header-title">
            <i class="material-icons">settings</i>
            {{ 'Configuration'|trans({}, 'Modules.Scalwaysdata.Admin') }}
        </h3>
    </div>
    <div class="card-body">
        <form method="post" action="{{ path('sc_alwaysdata_index') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('sc_alwaysdata_index') }}">

            <div class="form-group">
                <label for="logs_path">{{ 'Chemin des logs'|trans({}, 'Modules.Scalwaysdata.Admin') }}</label>
                <input
                    type="text"
                    id="logs_path"
                    name="logs_path"
                    class="form-control"
                    value="{{ logsPath }}"
                    placeholder="{{ logsPathHint }}"
                    required
                >
                <small class="form-text text-muted">
                    {{ 'Chemin absolu vers le répertoire des logs Alwaysdata (ex: %hint%)'|trans({'%hint%': logsPathHint}, 'Modules.Scalwaysdata.Admin') }}
                </small>
            </div>

            <div class="form-group">
                <label for="htaccess_path">{{ 'Chemin .htaccess'|trans({}, 'Modules.Scalwaysdata.Admin') }}</label>
                <input
                    type="text"
                    id="htaccess_path"
                    name="htaccess_path"
                    class="form-control"
                    value="{{ htaccessPath }}"
                >
                <small class="form-text text-muted">
                    {{ 'Chemin absolu vers le fichier .htaccess de PrestaShop.'|trans({}, 'Modules.Scalwaysdata.Admin') }}
                </small>
            </div>

            <button type="submit" class="btn btn-primary">
                <i class="material-icons">save</i>
                {{ 'Sauvegarder'|trans({}, 'Modules.Scalwaysdata.Admin') }}
            </button>
        </form>
    </div>
</div>

{# ------------------------------------------------------------------ #}
{# Section 2: Analysis trigger                                          #}
{# ------------------------------------------------------------------ #}
<div class="card mb-4">
    <div class="card-header">
        <h3 class="card-header-title">
            <i class="material-icons">analytics</i>
            {{ 'Analyse'|trans({}, 'Modules.Scalwaysdata.Admin') }}
        </h3>
    </div>
    <div class="card-body">
        {% if logsPath is empty %}
            <div class="alert alert-warning mb-0" role="alert">
                {{ 'Veuillez configurer le chemin des logs avant de lancer l\'analyse.'|trans({}, 'Modules.Scalwaysdata.Admin') }}
            </div>
        {% else %}
            <button type="button" class="btn btn-primary" id="btn-analyse">
                <i class="material-icons">play_arrow</i>
                {{ 'Analyser les logs du jour'|trans({}, 'Modules.Scalwaysdata.Admin') }}
            </button>
            <div id="analyse-spinner" class="mt-3" style="display:none">
                <div class="spinner-border text-primary" role="status">
                    <span class="sr-only">{{ 'Analyse en cours...'|trans({}, 'Modules.Scalwaysdata.Admin') }}</span>
                </div>
                <span class="ml-2 text-muted">{{ 'Analyse en cours...'|trans({}, 'Modules.Scalwaysdata.Admin') }}</span>
            </div>
        {% endif %}
    </div>
</div>

{# ------------------------------------------------------------------ #}
{# Section 3: Results (populated by JS)                                 #}
{# ------------------------------------------------------------------ #}
<div id="results-section" style="display:none">

    {# Source status badges #}
    <div id="sources-status" class="mb-3"></div>

    {# Crawlers subsection #}
    <div class="card mb-4" id="crawlers-section">
        <div class="card-header">
            <h3 class="card-header-title">
                <i class="material-icons">bug_report</i>
                {{ 'Crawlers détectés'|trans({}, 'Modules.Scalwaysdata.Admin') }}
            </h3>
        </div>
        <div class="card-body p-0">
            <table id="crawlers-table" class="table table-sm mb-0">
                <thead class="thead-light">
                    <tr>
                        <th>{{ 'IP'|trans({}, 'Modules.Scalwaysdata.Admin') }}</th>
                        <th>{{ 'User-Agents'|trans({}, 'Modules.Scalwaysdata.Admin') }}</th>
                        <th>{{ 'Requêtes/jour'|trans({}, 'Modules.Scalwaysdata.Admin') }}</th>
                        <th>{{ 'Raison'|trans({}, 'Modules.Scalwaysdata.Admin') }}</th>
                        <th>{{ 'Action'|trans({}, 'Modules.Scalwaysdata.Admin') }}</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td colspan="5" class="text-center text-muted">
                            {{ 'Aucun crawler invasif détecté'|trans({}, 'Modules.Scalwaysdata.Admin') }}
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    {# PHP Errors subsection #}
    <div class="card" id="php-errors-section">
        <div class="card-header">
            <h3 class="card-header-title">
                <i class="material-icons">error_outline</i>
                {{ 'Erreurs PHP'|trans({}, 'Modules.Scalwaysdata.Admin') }}
            </h3>
        </div>
        <div class="card-body p-0">
            <table id="php-errors-table" class="table table-sm mb-0">
                <thead class="thead-light">
                    <tr>
                        <th>{{ 'Niveau'|trans({}, 'Modules.Scalwaysdata.Admin') }}</th>
                        <th>{{ 'Fichier'|trans({}, 'Modules.Scalwaysdata.Admin') }}</th>
                        <th>{{ 'Ligne'|trans({}, 'Modules.Scalwaysdata.Admin') }}</th>
                        <th>{{ 'Message'|trans({}, 'Modules.Scalwaysdata.Admin') }}</th>
                        <th>{{ 'Occurrences'|trans({}, 'Modules.Scalwaysdata.Admin') }}</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td colspan="5" class="text-center text-muted">
                            {{ 'Aucune erreur PHP détectée'|trans({}, 'Modules.Scalwaysdata.Admin') }}
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

</div>

{# ------------------------------------------------------------------ #}
{# Inline JavaScript                                                    #}
{# ------------------------------------------------------------------ #}
<script>
var analyseUrl = '{{ path('sc_alwaysdata_analyse') }}';
var applyBlockUrl = '{{ path('sc_alwaysdata_apply_block') }}';
</script>

<script>
document.addEventListener('DOMContentLoaded', function() {
    var btn = document.getElementById('btn-analyse');
    var spinner = document.getElementById('analyse-spinner');
    var results = document.getElementById('results-section');

    if (!btn) return;

    btn.addEventListener('click', function() {
        btn.disabled = true;
        spinner.style.display = 'block';
        results.style.display = 'none';

        var csrfToken = getCsrfToken();

        fetch(analyseUrl, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: JSON.stringify({_token: csrfToken})
        })
        .then(function(r) { return r.json(); })
        .then(function(data) { renderResults(data); })
        .catch(function(err) { showError(err.message); })
        .finally(function() {
            btn.disabled = false;
            spinner.style.display = 'none';
        });
    });

    function renderResults(data) {
        if (data.error) {
            showError(data.error);
            return;
        }
        results.style.display = 'block';
        renderSources(data.sources || []);
        renderCrawlers(data.crawlers || []);
        renderPhpErrors(data.php_errors || []);
    }

    function renderSources(sources) {
        var container = document.getElementById('sources-status');
        if (!container) return;
        if (!sources.length) {
            container.innerHTML = '';
            return;
        }
        container.innerHTML = sources.map(function(s) {
            var cls = 'success';
            var label = escapeHtml(s.source);
            if (s.error) {
                cls = 'danger';
                label += ': ' + escapeHtml(s.error);
            } else if (s.truncated) {
                cls = 'warning';
                label += ' (tronqu\u00e9)';
            }
            return '<span class="badge badge-' + cls + ' mr-1">' + label + '</span>';
        }).join('');
    }

    function renderCrawlers(crawlers) {
        var tbody = document.querySelector('#crawlers-table tbody');
        if (!tbody) return;
        if (!crawlers.length) {
            tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted">Aucun crawler invasif d\u00e9tect\u00e9</td></tr>';
            return;
        }
        tbody.innerHTML = crawlers.map(function(c) {
            var userAgents = (c.user_agents || []).map(function(ua) {
                return escapeHtml(ua);
            }).join('<br>');
            var action;
            if (c.already_blocked) {
                action = '<span class="badge badge-secondary">D\u00e9j\u00e0 bloqu\u00e9</span>';
            } else {
                action = '<button class="btn btn-sm btn-danger apply-block"'
                    + ' data-type="ip"'
                    + ' data-value="' + escapeHtml(c.ip) + '">'
                    + 'Bloquer l\'IP'
                    + '</button>';
            }
            return '<tr class="' + (c.already_blocked ? 'text-muted' : '') + '">'
                + '<td>' + escapeHtml(c.ip) + '</td>'
                + '<td><small>' + userAgents + '</small></td>'
                + '<td>' + escapeHtml(String(c.request_count)) + '</td>'
                + '<td>' + escapeHtml(String(c.reason || '')) + '</td>'
                + '<td>' + action + '</td>'
                + '</tr>';
        }).join('');
        attachBlockHandlers();
    }

    function renderPhpErrors(errors) {
        var tbody = document.querySelector('#php-errors-table tbody');
        if (!tbody) return;
        if (!errors.length) {
            tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted">Aucune erreur PHP d\u00e9tect\u00e9e</td></tr>';
            return;
        }
        var levelClass = {
            fatal: 'danger',
            error: 'danger',
            warning: 'warning',
            notice: 'secondary',
            deprecated: 'light'
        };
        tbody.innerHTML = errors.map(function(e) {
            var cls = levelClass[e.level] || 'secondary';
            var filePath = String(e.file || '');
            var file = filePath.length > 50 ? '...' + filePath.slice(-50) : filePath;
            return '<tr>'
                + '<td><span class="badge badge-' + cls + '">' + escapeHtml(e.level) + '</span></td>'
                + '<td><small>' + escapeHtml(file) + '</small></td>'
                + '<td>' + escapeHtml(String(e.line || '-')) + '</td>'
                + '<td><small>' + escapeHtml(e.message || '') + '</small></td>'
                + '<td>' + escapeHtml(String(e.count || 0)) + '</td>'
                + '</tr>';
        }).join('');
    }

    function attachBlockHandlers() {
        document.querySelectorAll('.apply-block').forEach(function(blockBtn) {
            blockBtn.addEventListener('click', function() {
                var type = this.dataset.type;
                var value = this.dataset.value;
                var row = this.closest('tr');
                var self = this;
                self.disabled = true;

                var formData = new URLSearchParams();
                formData.append('_token', getCsrfToken());
                formData.append('type', type);
                formData.append('value', value);

                fetch(applyBlockUrl, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: formData.toString()
                })
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    if (data.success) {
                        row.querySelector('td:last-child').innerHTML = '<span class="badge badge-secondary">D\u00e9j\u00e0 bloqu\u00e9</span>';
                        row.classList.add('text-muted');
                    } else {
                        alert('Erreur: ' + (data.message || 'Erreur inconnue'));
                        self.disabled = false;
                    }
                })
                .catch(function() {
                    self.disabled = false;
                });
            });
        });
    }

    function getCsrfToken() {
        var input = document.querySelector('input[name="_token"]');
        return input ? input.value : '';
    }

    function escapeHtml(str) {
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    function showError(msg) {
        results.style.display = 'block';
        results.innerHTML = '<div class="alert alert-danger">'
            + '<i class="material-icons align-middle mr-1">error</i>'
            + escapeHtml(msg)
            + '</div>';
    }
});
</script>

{% endblock %}
